{
  "entity": "ImprovementInfo",
  "rootElement": "ImprovementInfo",
  "glob": "**/CIV4ImprovementInfos.xml",
  "channels": {
    "iCulture": {"scope": "plot", "channel": "culture", "kind": "flat"},
    "iDefenseModifier": {"scope": "plot", "channel": "defense", "kind": "percent", "member": "amount"},
    "iVisibilityChange": {"scope": "plot", "channel": "vision", "kind": "flat", "member": "visibilityRange"},
    "iSeeFrom": {"scope": "plot", "channel": "vision", "kind": "flat", "member": "seeFrom"},
    "_NOTE": "curate_improvement.families overrides these (plot scope). REMOVED misclassified channels (owner+classify 2026-06-16): iHealthPercent (drop, balance-cut as source); bCarriesIrrigation/bActsAsCity/bIsZOCSource/bIsUniversalTradeBonusProvider (identity capability flags, NOT enabler channels)."
  },
  "inversionsOut": {
    "TechYieldChanges": {"destEntity": "CvTechInfo", "shape": "yield.team.improvements.{IMPROVEMENT}.flat (curate_tech TECH_BOOSTS)"},
    "RouteYieldChanges": {"destEntity": "CvRouteInfo", "shape": "yield.plot.improvements.{IMPROVEMENT}.flat (curate_route ROUTE_BOOSTS)"}
  },
  "enablerEdges": {},
