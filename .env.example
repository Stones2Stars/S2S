# Tracked template. Copy to `.env` (gitignored) and set your local path.
# S2S_BTS_DIR = the folder that contains Civ4BeyondSword.exe (your Beyond the Sword install).
# The launch tooling derives the exe, the Stones2Stars mod, and the test save from this.
S2S_BTS_DIR=C:\Path\To\Civilization IV\Beyond the Sword
S2S_MOD_NAME=Stones2Stars
S2S_SAVE_GAME=testsave.CivBeyondSwordSave