{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Content -Raw -LiteralPath '.claude/post-compaction-reload.txt'\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
